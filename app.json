{
  "expo": {
    "name": "DevFlux",
    "slug": "DevFlux",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/AppIcons/devflux-app-icon.png",
    "scheme": [
      "devflux"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/AppIcons/devflux-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/AppIcons/devflux-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.marcos.devflux",
      "versionCode": 4
    },
    "web": {
      "output": "static",
      "favicon": "./assets/AppIcons/devflux-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withDevFluxAndroid"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "741af502-8942-42c9-b7c9-2b5f671d3622"
      }
    }
  }
}